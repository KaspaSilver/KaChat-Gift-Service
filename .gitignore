# Nothing in this list may ever be committed. The service reads all of it from a
# directory mounted at runtime, which lives on the operator's machine and not in
# this repository.
#
# The wallet key is the one that matters most: it spends real Kaspa, and a key
# in a public repository is drained within minutes of being pushed.

# Wallet
*.key
wallet.json
payer*.json

# Apple
*.p8
AuthKey_*
apple*.json

# Google
service-account*.json
play-integrity*.json
google-services.json

# Local configuration and state
.env
.env.*
!.env.example
/conf/
/data/
*.sqlite
*.db

# Node
node_modules/
npm-debug.log*
